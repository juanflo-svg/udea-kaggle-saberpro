# ─── Credenciales de Kaggle ────────────────────────────────────────────────────
# 1. Ve a https://www.kaggle.com/settings
# 2. Sección "API" → "Create New Token"
# 3. Descarga kaggle.json y copia los valores aquí

KAGGLE_USERNAME=tu_usuario_kaggle
KAGGLE_KEY=tu_api_key_de_kaggle

# ─── Cómo usar este archivo ────────────────────────────────────────────────────
# Copia este archivo como .env:
#   cp .env.example .env
#
# Luego edita .env con tus credenciales reales.
# NUNCA subas el archivo .env al repositorio.
#
# Alternativamente, coloca kaggle.json en:
#   Linux/Mac: ~/.kaggle/kaggle.json
#   Windows:   C:\Users\TU_USUARIO\.kaggle\kaggle.json
